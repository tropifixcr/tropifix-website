---
import { Image } from 'astro:assets';
import logo from '../../Logos/tropifix-transparent.png';
import type { Dict } from '../i18n/en';
interface Props { t: Dict; switchTo: string; requestHref: string }
const { t, switchTo, requestHref } = Astro.props;
---
<header class="header">
  <div class="wrap header__in">
    <a href={t.home} class="header__logo" aria-label="TropiFix">
      <Image src={logo} alt={t.logoAlt} widths={[130, 260]} sizes="130px" width={130} loading="eager" />
    </a>
    <nav class="header__nav" aria-label="Main">
      <a href={`${t.home}#services`}>{t.nav.services}</a>
      <a href={`${t.home}#how`}>{t.nav.how}</a>
      <a href={`${t.home}#zones`}>{t.nav.zones}</a>
      <a href={`${t.home}#faq`}>{t.nav.faq}</a>
    </nav>
    <div class="header__end">
      <a href={switchTo} class="header__lang" lang={t.switchLang.lang} hreflang={t.switchLang.lang} aria-label={t.switchLang.aria} data-lang-switch>
        {t.switchLang.lang.toUpperCase()}
      </a>
      <a href={requestHref} class="btn btn--coral header__cta" aria-label={t.cta}>
        <span class="header__cta-short">{t.ctaShort}</span>
        <span class="header__cta-full">{t.cta}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .header__in { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); padding-block: var(--space-2); }
  .header__logo { display: flex; min-height: 48px; align-items: center; flex: none; }
  .header__logo :global(img) { width: 120px; }
  .header__cta-full { display: none; }
  .header__nav { display: none; gap: var(--space-6); }
  .header__nav a { color: var(--ink); text-decoration: none; font-weight: 700; padding-block: var(--space-2); }
  .header__nav a:hover { color: var(--teal); text-decoration: underline; }
  .header__end { display: flex; align-items: center; gap: var(--space-2); }
  .header__lang { display: grid; place-items: center; min-width: 48px; min-height: 48px; font-weight: 700; color: var(--teal); }
  .header__cta { padding-inline: var(--space-4); white-space: nowrap; }
  @media (min-width: 480px) {
    .header__logo :global(img) { width: 130px; }
    .header__cta-short { display: none; }
    .header__cta-full { display: inline; }
  }
  @media (min-width: 900px) { .header__nav { display: flex; } }
</style>
