---
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/nunito-sans/latin-400.css';
import '@fontsource/nunito-sans/latin-700.css';
// The two fonts above the fold on every page are preloaded so text doesn't shift when they arrive.
import headingFont from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';
import bodyFont from '@fontsource/nunito-sans/files/nunito-sans-latin-400-normal.woff2?url';
import '../../brand/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { indexable } from '../../site.config.mjs';
import { gaId } from '../data/settings';
import type { Dict } from '../i18n/en';

interface Props {
  t: Dict;
  title: string;
  description: string;
  /** This page's address in each language, for hreflang and the language toggle. */
  paths: { en: string; es: string };
  /** schema.org objects, written out as JSON-LD. */
  schema?: object[];
  /** True when the request form is on this page, so "Request a fix" scrolls instead of leaving. */
  hasForm?: boolean;
  /** Keeps a page out of search engines even on the real domain (404). */
  noindex?: boolean;
}
const { t, title, description, paths, schema = [], hasForm = false, noindex = false } = Astro.props;
const abs = (path: string) => new URL(path, Astro.site).href;
const lang = t.lang as 'en' | 'es';
const canonical = abs(paths[lang]);
const ogImage = abs('/og-default.jpg');
const analytics = Boolean(gaId) && process.env.CONTEXT === 'production';
---
<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={abs(paths.en)} />
    <link rel="alternate" hreflang="es" href={abs(paths.es)} />
    <link rel="alternate" hreflang="x-default" href={abs(paths.en)} />
    {(!indexable || noindex) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TropiFix" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_CR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" as="font" type="font/woff2" href={headingFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {schema.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...item })} />
    ))}
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      // Site-wide event helper. Sends nothing unless the visitor accepted analytics.
      window.tfTrack = function (name, params) {
        if (window.tfAnalyticsOn) window.gtag('event', name, params || {});
      };
    </script>
    {analytics && (
      <script is:inline define:vars={{ gaId }}>
        // Google Consent Mode v2, basic mode: GA4 is not requested at all until the visitor accepts.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('consent', 'default', {
          ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied',
        });
        window.tfLoadAnalytics = function () {
          // ?test visits (manual test leads) are never measured.
          if (window.tfAnalyticsOn || new URLSearchParams(location.search).has('test')) return;
          window.tfAnalyticsOn = true;
          window.gtag('consent', 'update', { analytics_storage: 'granted' });
          window.gtag('js', new Date());
          window.gtag('config', gaId);
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(script);
        };
        var choice = null;
        try { choice = localStorage.getItem('tf-consent'); } catch (e) {}
        // Set before first paint, so the banner never appears and then jumps away.
        if (choice) document.documentElement.classList.add('consent-set');
        if (choice === 'granted') window.tfLoadAnalytics();
      </script>
    )}
  </head>
  <body>
    {analytics && <CookieBanner t={t} />}
    <Header t={t} switchTo={paths[t.switchLang.lang as 'en' | 'es']} requestHref={hasForm ? '#request' : `${t.home}#request`} />
    <main>
      <slot />
    </main>
    <Footer t={t} switchTo={paths[t.switchLang.lang as 'en' | 'es']} cookieSettings={analytics} />
    <slot name="after" />
    <script>
      // Fade sections in once as they scroll into view.
      const seen = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          seen.unobserve(entry.target);
        }
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => seen.observe(el));

      // Analytics events for tagged links (WhatsApp buttons).
      document.querySelectorAll<HTMLElement>('[data-track]').forEach((el) =>
        el.addEventListener('click', () => window.tfTrack(el.dataset.track!)),
      );
    </script>
  </body>
</html>
