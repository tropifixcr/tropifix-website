{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/es/index.html",
        "http://localhost/services/pool-care.html",
        "http://localhost/es/servicios/mantenimiento-piscinas.html",
        "http://localhost/privacy.html",
        "http://localhost/es/privacidad.html",
        "http://localhost/404.html"
      ]
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*404).*$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "pessimistic" }],
            "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "pessimistic" }],
            "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "pessimistic" }]
          }
        },
        {
          "matchingUrlPattern": ".*404.*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
            "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "pessimistic" }],
            "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "pessimistic" }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/reports" }
  }
}
